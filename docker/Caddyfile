:80 {
  encode zstd gzip

  @api path /api /api/* /uploads /uploads/* /api/health

  handle @api {
    reverse_proxy 127.0.0.1:3000
  }

  redir /admin /admin/

  handle_path /admin/* {
    root * /srv/admin
    try_files {path} /index.html
    file_server
  }

  handle {
    root * /srv/storefront
    try_files {path} /index.html
    file_server
  }
}
