root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
charset = utf-8

[*.{ts,tsx,js,jsx,vue,css,scss,html,md}]
charset = utf-8-bom

[*.{json,yml,yaml,prisma}]
charset = utf-8

[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
