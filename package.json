{
  "name": "cardverse",
  "version": "1.0.0",
  "description": "Node.js digital goods and card delivery system",
  "private": true,
  "license": "ISC",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node scripts/with-db-env.js node dist/main.js",
    "start:dev": "node scripts/with-db-env.js nest start --watch",
    "start:debug": "node scripts/with-db-env.js nest start --debug --watch",
    "prisma:generate": "node scripts/with-db-env.js prisma generate",
    "prisma:migrate": "node scripts/with-db-env.js prisma migrate dev",
    "prisma:db:push": "node scripts/with-db-env.js prisma db push",
    "prisma:seed": "node scripts/with-db-env.js ts-node --project tsconfig.json prisma/seed.ts",
    "test": "node -e \"console.log('No tests configured yet')\""
  },
  "prisma": {
    "seed": "node scripts/with-db-env.js ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^6.16.2",
    "@types/nodemailer": "^7.0.11",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.16",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "playwright": "^1.58.2",
    "prisma": "^6.16.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
